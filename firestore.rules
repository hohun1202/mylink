rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 사용자 프로필 (users/{userId}) =====
    match /users/{userId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      // displayName(= 공개 페이지 주소)은 다른 사람과 겹치면 안 되므로 내 마음대로 정하거나 바꿀 수 없다
      //   - 처음 만들 때: 내 구글 이메일의 @ 앞부분이어야 함 (앱이 자동으로 넣는 값)
      //   - 고칠 때: displayName 은 그대로여야 함 (이름·소개 등 다른 필드만 수정 가능)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.displayName == request.auth.token.email.split('@')[0];
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.displayName == resource.data.displayName;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 프로필 수정 저장본 (users/{userId}/profile/main) =====
    // 마이페이지 [프로필 수정]이 users/{userId} 와 한 묶음(배치)으로 여기에 저장한다.
    // 이 블록이 없으면 이 경로 쓰기가 거절되고, 묶음 전체가 실패해 프로필 수정이 안 된다.
    match /users/{userId}/profile/{docId} {
      // 읽기: 누구나 가능
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 링크 서브컬렉션 (users/{userId}/links) =====
    match /users/{userId}/links/{linkId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;

      // 예외 — 클릭 수 올리기: 공개 페이지 방문자(로그인 안 해도 됨)가 링크를 누르면 clickCount 를 +1 한다
      //   - 바뀌는 필드가 clickCount 하나뿐이어야 함 (제목·주소 등은 못 건드림)
      //   - 새 값 = 이전 값 + 1 이어야 함 (한 번에 1씩만. 없던 필드면 0 → 1)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
        && request.resource.data.clickCount == resource.data.get('clickCount', 0) + 1;
    }
  }
}
