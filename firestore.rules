rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 사용자 프로필 (users/{userId}) =====
    match /users/{userId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 프로필 수정 저장본 (users/{userId}/profile/main) =====
    // 마이페이지 [프로필 수정]이 users/{userId} 와 한 묶음(배치)으로 여기에 저장한다.
    // 이 블록이 없으면 이 경로 쓰기가 거절되고, 묶음 전체가 실패해 프로필 수정이 안 된다.
    match /users/{userId}/profile/{docId} {
      // 읽기: 누구나 가능
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 링크 서브컬렉션 (users/{userId}/links) =====
    match /users/{userId}/links/{linkId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
